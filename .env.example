# Autenticación con Microsoft Entra ID (MSAL) + GraphQL API de Microsoft Fabric.
#
# Todas llevan prefijo NEXT_PUBLIC_ porque MSAL corre en el navegador: Next las
# inlinea en el bundle en tiempo de BUILD. En Docker van como build args (ver
# Dockerfile y docker-compose.yml), así que cambiarlas exige reconstruir la
# imagen — reiniciar el contenedor no alcanza.
#
# Sin CLIENT_ID y TENANT_ID la app arranca en modo demostración: no pide login,
# usa el respaldo seed (lib/seed-data.ts) y pinta el banner "Modo offline".
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=

# Opcional: por defecto window.location.origin. Tiene que estar registrada como
# redirect URI de tipo SPA en el registro de aplicación de Entra ID.
NEXT_PUBLIC_ENTRA_REDIRECT_URI=

# Endpoint de la GraphQL API del elemento de Fabric.
NEXT_PUBLIC_FABRIC_GRAPHQL_ENDPOINT=

# Puertos publicados en el host (opcionales).
PORT=3000
DEV_PORT=3001
